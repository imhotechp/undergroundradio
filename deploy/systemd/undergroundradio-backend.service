[Unit]
Description=undergroundradio Django backend (gunicorn/wsgi)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/backend
# Runs under gunicorn/WSGI, not uvicorn/ASGI — every view here is a plain
# synchronous DRF APIView (nothing needs websockets/async), and Django's ASGI
# adapter serializes sync view execution onto a single thread per process
# regardless of --workers count. That showed up as a load test where adding
# uvicorn workers cut errors to 0% but barely moved p95 latency (still ~4.5s
# at 50 concurrent users). Gunicorn's sync workers don't have that
# serialization layer, so worker count translates directly into concurrency.
# EDIT: set --workers to roughly (2 x CPU cores) + 1 for this box, then
# re-run deploy/k6/load-test.js and adjust from there.
#
# --worker-class gthread --threads 4: each worker handles up to 4 requests
# concurrently via threads instead of just 1. Chosen over more plain workers
# because every view here is I/O-bound (waiting on Neon over the network,
# not CPU work) — a thread sitting idle on that wait costs far less than a
# whole extra process would. 4 workers x 4 threads = 16 concurrent request
# slots instead of 4.
ExecStart=/srv/backend/venv/bin/gunicorn ug_radio_django.wsgi:application --bind 127.0.0.1:8000 --workers 4 --worker-class gthread --threads 4

# NEON_* DB credentials are already read from the tracked ug_radio_django/.env
# file via python-dotenv — no need to duplicate them here. JWT key paths default
# to /srv/mp3private.key and /srv/mp3public.key already, matching this server.
#
# DEBUG and SECRET_KEY, on the other hand, must NOT live in that tracked .env —
# set the real values here instead:
Environment=DJANGO_DEBUG=False
# EDIT: generate a real secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`
Environment=DJANGO_SECRET_KEY=REPLACE_WITH_A_REAL_SECRET_NEVER_COMMITTED

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
