# Loaded automatically by `next build`/`next start` in production. Relative path
# works because nginx reverse-proxies /api/ to the Django backend on the same
# origin (undergroundradio.us) — no CORS needed for real traffic.
NEXT_PUBLIC_API_BASE_URL=/api

# Sentry error monitoring — DSNs are meant to be public (write-only ingestion
# endpoints), safe to commit. Leave blank to disable; Sentry.init() with no
# dsn just no-ops instead of throwing. Get this from Sentry > Project
# Settings > Client Keys (DSN) after creating a project.
NEXT_PUBLIC_SENTRY_DSN=
