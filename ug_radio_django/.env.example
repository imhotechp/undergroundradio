# Copy to .env and fill in real values. Never commit the real .env file —
# in production, this lives only on the server (currently /srv/backend/ug_radio_django/.env).

# Neon Postgres
NEON_HOST=
NEON_DB=
NEON_USER=
NEON_PASS=
NEON_PORT=5432

# Brevo SMTP relay (Settings > SMTP & API > SMTP in the Brevo dashboard)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Optional; defaults to no-reply@undergroundradio.us if unset
# DEFAULT_FROM_EMAIL=no-reply@undergroundradio.us

# Sentry error monitoring — leave blank to disable. Get this from Sentry >
# Project Settings > Client Keys (DSN) after creating a project.
SENTRY_DSN=
# Optional; defaults to "development" locally / "production" when
# DJANGO_DEBUG=False.
# SENTRY_ENVIRONMENT=

# Cloudflare R2 — write credential for the shared 'emerald' bucket, needed
# only for `manage.py process_transcode_jobs` (video HLS transcoding) to
# upload its output. Generate in the Cloudflare dashboard with write access
# scoped to this bucket. Leave blank and the command just can't run — it
# doesn't affect anything else.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional; defaults to the account endpoint mp3juug's save.js already uses
# R2_ENDPOINT=
# Optional; defaults to "emerald"
# R2_BUCKET=
# Optional; defaults to the r2-public-worker URL everything else is served from
# R2_PUBLIC_BASE_URL=
