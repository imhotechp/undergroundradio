# Copy to .env and fill in real values. Never commit the real .env file —
# in production, this lives only on the server (currently /srv/backend/ug_radio_django/.env).

# Neon Postgres
NEON_HOST=
NEON_DB=
NEON_USER=
NEON_PASS=
NEON_PORT=5432

# Brevo SMTP relay (Settings > SMTP & API > SMTP in the Brevo dashboard)
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Optional; defaults to no-reply@undergroundradio.us if unset
# DEFAULT_FROM_EMAIL=no-reply@undergroundradio.us

# Sentry error monitoring — leave blank to disable. Get this from Sentry >
# Project Settings > Client Keys (DSN) after creating a project.
SENTRY_DSN=
# Optional; defaults to "development" locally / "production" when
# DJANGO_DEBUG=False.
# SENTRY_ENVIRONMENT=
